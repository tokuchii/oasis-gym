# Supabase (create project at supabase.com, then run supabase/schema.sql in SQL Editor)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Staff dashboard login (choose a strong password)
ADMIN_PASSWORD=change-me-to-a-strong-password

# Session signing secret (generate with: openssl rand -base64 32)
SESSION_SECRET=change-me-to-a-random-secret
