# Supabase (create project at supabase.com, then run supabase/schema.sql in SQL Editor)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Staff dashboard login (choose a strong password)
ADMIN_PASSWORD=change-me-to-a-strong-password

# Session signing secret (generate with: openssl rand -base64 32)
SESSION_SECRET=change-me-to-a-random-secret

# Gmail SMTP for sending emails (no domain needed)
# 1. Go to myaccount.google.com → Security → 2-Step Verification (enable it)
# 2. Then go to myaccount.google.com → Security → App passwords → Generate one for "Mail"
# 3. Paste the 16-char app password below (not your Gmail password)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
