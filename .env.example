# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Staff dashboard login
ADMIN_PASSWORD=change-me-to-a-strong-password

# Session signing secret
SESSION_SECRET=change-me-to-a-random-secret

# SMTP settings (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_FROM="OASIS FITNESS GYM <your-gmail@gmail.com>"

# Contact form recipient
CONTACT_EMAIL_TO=your-gmail@gmail.com

# Google Gemini API key (receipt OCR)
GEMINI_API_KEY=your-gemini-api-key

# Extra CORS origins (comma-separated) beyond the defaults
# Defaults already include the Vercel domain and localhost dev origins
CORS_ALLOWED_ORIGINS=https://your-custom-domain.com
